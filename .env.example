# ATC Similarity Analyzer - 환경 설정 예제
#
# 사용 방법:
# 1. 이 파일을 복사: cp .env.example .env
# 2. 아래 값들을 실제 값으로 변경
# 3. .env는 절대 git에 커밋하지 않음 (.gitignore에 등록됨)

################################
# 데이터베이스
################################
DATABASE_URL=sqlite:///similarity_detector.db

################################
# 보안
################################
# Flask SECRET_KEY (배포 시 반드시 강력한 키로 변경)
# Python 생성 방법: python -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET_KEY=change-this-secret-key-in-production

################################
# 세션 설정
################################
APP_SESSION_TIMEOUT_HOURS=24
APP_SESSION_TIMEOUT_SECONDS=86400

################################
# 포트 설정 (배포 시 환경에서 자동 할당)
################################
API_PORT=8888
FRONTEND_PORT=8000

################################
# 개발 모드
################################
# True: 개발 모드 (디버그 활성화)
# False: 프로덕션 모드
DEBUG=False
FLASK_ENV=production

################################
# 라이선스 (선택)
################################
# LICENSE_TYPE=development  # 또는 commercial
# LICENSE_KEY=your-license-key

################################
# 배포 플랫폼별 설정
################################

# === Render.com ===
# Render에서 이 환경변수들을 설정하면 자동 반영됨
# 위의 값들을 Render 대시보드에 입력하면 됨

# === Railway.app ===
# Railway에서 자동으로 PORT 환경변수를 제공함
# 프로젝트에서 os.environ.get('PORT', 8888) 사용

# === Docker / 로컬 ===
# 1. .env 파일 생성: cp .env.example .env
# 2. 값 수정
# 3. 실행: source .env && python backend/app.py
